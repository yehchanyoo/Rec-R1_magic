Bootstrap: docker
From: ubuntu:noble

%environment
    export CC=gcc
    export PYTHONUNBUFFERED=1
    export DEBIAN_FRONTEND=noninteractive
    export MAX_JOBS=4
    export NINJA_FLAGS="-j4"
    export HF_HOME="/home/ubuntu/.cache/huggingface"

%files
    . /home/ubuntu/Rec-R1_magic

%post
    apt-get update && apt-get install -y \
        wget curl \
        ca-certificates \
        bzip2 \
        libglib2.0-0 \
        libxext6 \
        libsm6 \
        libxrender1 \
        default-jdk default-jre \
	build-essential \
        git vim && \
	apt-get clean && \
	rm -rf /var/lib/apt/lists/*


    echo "Installing conda"
    mkdir -p /opt/conda
    wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /opt/conda/miniconda.sh
    bash /opt/conda/miniconda.sh -b -u -p /opt/conda
    rm /opt/conda/miniconda.sh
    . /opt/conda/bin/activate
    conda install python=3.12 -y


    echo ">>> Installing uv..."
    pip3 install --no-cache-dir uv

    echo ">>> Installing critical pip packages..."
    uv pip install --system --no-cache-dir --no-build-isolation torch==2.4.0 torchvision==0.19.0 torchaudio==2.4.0 --index-url https://download.pytorch.org/whl/cu124
    uv pip install --system --no-cache-dir --no-build-isolation vllm==0.6.3

    echo ">>> Installing common pip packages..."
    uv pip install --system --no-cache-dir \
        "torch==2.4.0" \
        accelerate \
        codetiming \
        datasets \
        dill \
        hydra-core \
        numpy \
        pybind11 \
        tensordict \
        ipython \
        matplotlib \
        seaborn \
        blis \
	hf_xet \
        "transformers <= 4.46.0" 

    echo ">>> Installing utility packages..."
    uv pip install --system --no-cache-dir wandb py-spy pyserini

    echo ">>> Installing faiss and CUDA dependencies via conda..."
    conda install -y -c pytorch -c nvidia -c conda-forge \
        cuda-toolkit=12.4 \
        faiss-gpu=1.11.0 && \
    conda clean -afy
    
    echo ">>> Installing local Rec-R1_magic package..."
    cd /home/ubuntu/Rec-R1_magic && \
    uv pip install --system --no-build-isolation -e .
